# Spec 8.2 — no secret may enter source control.
APP_BASE_URL=http://localhost:3000

DATABASE_HOST=
DATABASE_PORT=3306
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# [OPEN] Sender identity is not yet approved. Leave unset to keep the
# email worker in dry-run mode instead of sending under an invented identity.
EMAIL_FROM=
EMAIL_REPLY_TO=
INTERNAL_LEAD_RECIPIENT=

PRIVATE_TEMPLATE_DIR=./private-storage/templates

# Where the template HTML/PDF sources live. They are not committed, so set
# this if they are not at the default path relative to the project root.
TEMPLATE_SOURCE_DIR=LinkGurusAI/linkgurus-new-website/assets/templates
DOWNLOAD_TOKEN_PEPPER=
CRON_SECRET=
RATE_LIMIT_SALT=

# Optional, unset until approved
ANALYTICS_ID=
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=
